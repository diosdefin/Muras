{
  "name": "redbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-data.mjs",
    "prebuild": "node scripts/validate-locales.mjs && node scripts/build-data.mjs",
    "build": "vite build",
    "postbuild": "node scripts/admin-entry.mjs",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "data:generate": "node scripts/build-data.mjs",
    "data:validate": "node scripts/validate-locales.mjs && node scripts/build-data.mjs --check",
    "data:images": "python scripts/process_data.py",
    "data:batch:prepare": "node scripts/prepare-research-batch.mjs",
    "data:batch:photos": "node scripts/prepare-batch-images.mjs",
    "data:batch:import": "node scripts/import-species-batch.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5"
  }
}
